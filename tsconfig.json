{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2021",
    "lib": [
      "es2021"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "credentials/**/*.ts",
    "nodes/**/*.ts"
  ]
}